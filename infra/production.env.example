# DIST-04: infra/.env of the production stack on Omarchy (copy to infra/.env, mode 0600). Passwords and the
# Cloudflare token live in secrets/, never here. MENU-28: the real host names live only in infra/.env (not in git).
WOTR_VERSION=<commit or version of this checkout>
WOTR_DATABASE=wotr
WOTR_DOMAIN=game.example.org
WOTR_DATA_DIR=/srv/wotr/data
WOTR_PROXY_IP=172.30.93.2
WOTR_SERVER_IP=172.30.93.3
WOTR_PROXY_SUBNET=172.30.93.0/24
WOTR_EXPANSIONS=false
# EXP-01: expansions are released one by one (fate, then lords, then kings), e.g. WOTR_RELEASE_MODULES=fate; when set it
# wins over WOTR_EXPANSIONS. Empty: WOTR_EXPANSIONS decides.
WOTR_RELEASE_MODULES=
# EXP-02: required for each released module: the first client release that plays it, e.g. WOTR_MODULE_CLIENTS=fate=0.10.0.
# Older clients are sent to the update at that module's tables.
WOTR_MODULE_CLIENTS=
# TEST-08 (D19): test scenarios for every signed-in account.
WOTR_TEST_SCENARIOS=true
WOTR_ACCEPT_UNVERSIONED_CLIENTS=false
# ADMIN-01: administrators of https://WOTR_DOMAIN/admin — existing account names, comma-separated. Empty: no admin.
WOTR_ADMIN_ACCOUNTS=
# Release catalog (DIST-05) and downloads host (DIST-04).
WOTR_RELEASES_ROOT=/distribution
WOTR_DISTRIBUTION_DIR=/srv/wotr/distribution
# The provider blocks incoming 443: the router forwards WAN 50443 to the host's 443 (downloads).
WOTR_DOWNLOADS_URL=https://downloads.example.org:50443/
WOTR_DOWNLOADS_HOST=downloads.example.org
WOTR_RELEASE_PUBLIC_KEY=assXbu7Zbo494JMal54lWXX3LdodwnzpOiwz40RXDG4=
# downloads, certbot and ddns; leave empty until the Cloudflare token, DHCP lease and port 443 are in place.
COMPOSE_PROFILES=
# AUTH-02: account emails. none until the sending domain is verified in Resend; then resend, the sender (from that
# domain) and the API key in secrets/resend_api_key (0400). Links point to https://WOTR_DOMAIN.
WOTR_EMAIL_PROVIDER=none
WOTR_EMAIL_FROM="War of the Ring Online <no-reply@example.org>"
