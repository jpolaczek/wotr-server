# DIST-04: ${WOTR_DOWNLOADS_HOST} straight from the host's public IP (DNS-only, router port 443 → 8443 here).
# Only the published release files, read-only and immutable; Range requests resume a broken download.
# Limits of the PF-01 budget keep the upload free for the game: 8 MB/s per connection, 4 per address, 8 in all.
log_format downloads '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent $request_time';
limit_conn_zone $binary_remote_addr zone=per_address:1m;
limit_conn_zone $server_name zone=all_downloads:1m;

server {
  listen 8443 ssl;
  http2 on;
  server_name ${WOTR_DOWNLOADS_HOST};
  server_tokens off;
  access_log /dev/stdout downloads;
  ssl_certificate /etc/letsencrypt/live/${WOTR_DOWNLOADS_HOST}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${WOTR_DOWNLOADS_HOST}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  root /srv/public;
  autoindex off;
  add_header Strict-Transport-Security "max-age=15552000" always;
  add_header X-Content-Type-Options "nosniff" always;

  location /releases/ {
    limit_except GET { deny all; }
    limit_conn per_address 4;
    limit_conn all_downloads 8;
    limit_conn_status 429;
    limit_rate 8m;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location / {
    return 404;
  }
}

# Any other name or a bare address gets no certificate at all.
server {
  listen 8443 ssl default_server;
  ssl_reject_handshake on;
}

# Health check inside the container only.
server {
  listen 127.0.0.1:8081;
  access_log off;
  location = /healthz {
    default_type text/plain;
    return 200 "ok\n";
  }
  location / {
    return 404;
  }
}
