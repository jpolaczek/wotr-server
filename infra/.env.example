# These are public deployment settings. Passwords live in secrets/.
WOTR_VERSION=0.1.0-rc1
WOTR_DATABASE=wotr
WOTR_DOMAIN=localhost
WOTR_BIND=127.0.0.1
WOTR_HTTP_PORT=8088
WOTR_HTTPS_PORT=8443
WOTR_CADDYFILE=./Caddyfile.local
WOTR_PROXY_IP=172.30.93.2
WOTR_SERVER_IP=172.30.93.3
WOTR_PROXY_SUBNET=172.30.93.0/24
# UI-96: new tables are base game only; true also offers the expansions.
WOTR_EXPANSIONS=false
# EXP-01: the released modules, e.g. fate or fate,lords; when set it wins over WOTR_EXPANSIONS. Empty: WOTR_EXPANSIONS.
WOTR_RELEASE_MODULES=
# EXP-02: the first client version of each released module, e.g. fate=0.10.0 or fate=0.10.0,lords=0.11.0.
WOTR_MODULE_CLIENTS=
# DIST-05: client release catalog; leave empty until DIST-04 serves the downloads host.
WOTR_RELEASES_ROOT=
WOTR_DOWNLOADS_URL=
WOTR_RELEASE_PUBLIC_KEY=
WOTR_DISTRIBUTION_DIR=./distribution
# true only while players still use ZIP clients without version headers.
WOTR_ACCEPT_UNVERSIONED_CLIENTS=false
# TEST-01: true offers test scenarios to every signed-in account; production enables it since D19 (TEST-08).
WOTR_TEST_SCENARIOS=false
