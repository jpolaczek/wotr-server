<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the same presentation fixture into its focused projection tests. -->
    <Compile Include="../Wotr.Scenarios/InGameProfileScenario.cs" Link="Fixtures/InGameProfileScenario.cs" />
    <Compile Include="../Wotr.Scenarios/ExpansionUiMatrix.cs" Link="Fixtures/ExpansionUiMatrix.cs" />
    <Compile Include="../Wotr.Scenarios/ExpansionUiFixture.cs" Link="Fixtures/ExpansionUiFixture.cs" />
    <Compile Include="../Wotr.Scenarios/BoardProfileScenario.cs" Link="Fixtures/BoardProfileScenario.cs" />
    <Compile Include="../Wotr.Scenarios/CharacterRosterScenario.cs" Link="Fixtures/CharacterRosterScenario.cs" />
    <Compile Include="../Wotr.Scenarios/CharacterScenario.cs" Link="Fixtures/CharacterScenario.cs" />
    <Compile Include="../Wotr.Scenarios/CouncilHomelandScenario.cs" Link="Fixtures/CouncilHomelandScenario.cs" />
    <Compile Include="../Wotr.Scenarios/BattleScenario.cs" Link="Fixtures/BattleScenario.cs" />
    <Compile Include="../Wotr.Scenarios/FellowshipScenario.cs" Link="Fixtures/FellowshipScenario.cs" />
    <None Include="../fixtures/base-regression/**/*.json" Link="Fixtures/Base/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/expansion-regression/**/*.json" Link="Fixtures/Expansions/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/contract-legacy/*.json;../fixtures/contract-legacy/*.txt" Link="Fixtures/Legacy/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/replays/*.wotrreplay" Link="Fixtures/Replays/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1"><PrivateAssets>all</PrivateAssets></PackageReference>
    <ProjectReference Include="../../src/Wotr.Domain/Wotr.Domain.csproj" />
    <ProjectReference Include="../../src/Wotr.Server/Wotr.Server.csproj" />
  </ItemGroup>
</Project>
